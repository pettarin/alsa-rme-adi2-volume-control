[Unit]
Description=ALSA plugin to control the volume of a RME ADI-2 device via MIDI
Documentation=https://github.com/pettarin/alsa-rme-adi-2-volume-control
After=sound.target
Before=mpd.service

[Service]
Type=simple
# TODO update the command line with the appropriate parameters
ExecStart=/usr/local/bin/alsa-rme-adi-2-volume-control
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
