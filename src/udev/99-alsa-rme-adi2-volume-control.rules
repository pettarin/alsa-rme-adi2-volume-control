# Restart the alsa-rme-adi2-volume-control service
# every time an RME ADI-2 device is connected,
# ensuring the ALSA virtual mixer is ready to control it.
#
# Note that this also handles the case when the device
# stays physically connected, but it is powered off and then on again.
#
# RME USB Vendor ID is "2a39".

ACTION=="add", SUBSYSTEM=="sound", ATTRS{idVendor}=="2a39", TAG+="systemd", RUN+="/bin/systemctl restart alsa-rme-adi2-volume-control.service"
